// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Legacy windows reference — markup snapshots > EdgeDetailPopup 1`] = `"<div class="popup ds-ov-item ds-ov-surface ds-ov-edge-detail" data-testid="edge-detail-popup" aria-label="Edge detail popup" style="position: static; left: auto; top: auto; right: auto; z-index: auto;"><div class="popup__title ds-label">Edge</div><div class="popup__subtitle ds-value ds-mono">alice → bob</div><div class="popup__grid"><div class="ds-label">Used</div><div class="ds-value ds-mono">12 UAH</div><div class="ds-label">Limit</div><div class="ds-value ds-mono">100 UAH</div><div class="ds-label">Available</div><div class="ds-value ds-mono">88 UAH</div><div class="ds-label">Status</div><div class="ds-value ds-mono">active</div></div><!-- ED-2: capacity utilization bar (used/limit), shown under the stats grid. --><div class="popup__util" aria-label="Utilization"><div class="popup__util-bar" role="progressbar" aria-label="Utilization bar" aria-valuenow="12" aria-valuetext="12%" aria-valuemin="0" aria-valuemax="100"><div class="popup__util-fill" style="width: 12%; background: var(--ds-ok);"></div></div><div class="popup__util-pct ds-label ds-mono" data-testid="edge-utilization-pct">12%</div></div><div class="popup__actions"><!--v-if--><!--v-if--><!--v-if--><div class="ds-label ds-mono" data-testid="edge-close-request-note"> Closing with debt (used: 12 UAH) is a request: limit becomes 0 until repaid. </div><button class="ds-btn ds-btn--secondary ds-btn--sm" type="button" data-testid="edge-send-payment"> 💸 Pay alice</button><div class="ds-label ds-mono" data-testid="edge-payment-direction-note">This line runs from creditor to debtor; Pay starts a payment from debtor to creditor. For the part sent directly, any reverse debt is offset first, and only the remainder increases the debtor’s debt under this line’s limit; it does not repay that debt. The server may route some or all of the payment through other participants.</div><button class="ds-btn ds-btn--secondary ds-btn--sm" type="button"> Change limit </button><button class="ds-btn ds-btn--danger ds-btn--sm" type="button" data-testid="edge-close-line-btn">Close line</button><!--v-if--><button class="ds-btn ds-btn--ghost ds-btn--sm" type="button">Close</button></div></div>"`;

exports[`Legacy windows reference — markup snapshots > NodeCardOverlay 1`] = `"<div class="ds-ov-node-card" style="position: static; left: auto; top: auto; right: auto; z-index: auto;"><div class="ds-panel ds-panel--elevated"><div class="ds-panel__body ds-ov-node-card__body"><!-- Identity + Balance (merged) ------------------------------------><div class="ds-ov-node-card__identity"><div class="ds-node-card__avatar ds-ov-node-card__avatar">BO</div><div class="ds-ov-node-card__text"><div class="ds-node-card__name">Bob</div><div class="ds-node-card__meta">person · active</div><div class="nco-role" data-testid="node-card-role" data-role="creditor"><span class="ds-data-swatch ds-data-swatch--role" style="background-color: #4c8dff; border-color: #4c8dff;" data-testid="node-card-role-swatch" aria-hidden="true">+</span><span>Is owed more</span></div></div><div class="ds-ov-node-card__right"><div class="ds-ov-node-card__service"><button class="ds-btn ds-btn--ghost ds-btn--icon ds-ov-node-card__action-btn" type="button" aria-label="Pin" title="Pin">◇</button><button class="ds-btn ds-btn--ghost ds-btn--icon ds-ov-node-card__action-btn" type="button" aria-label="Close" title="Close"> × </button></div><div class="ds-ov-node-card__balance" style="color: #4c8dff;">42.00</div></div></div><!-- Separator --------------------------------------------------------><hr class="ds-ov-node-card__divider"><!-- Stats (only unique fields: Out, In, Degree) ----------------------><div class="ds-ov-node-card__stats"><div class="ds-ov-node-card__stat"><span class="ds-label">Out</span><span class="ds-value ds-mono">100</span></div><div class="ds-ov-node-card__stat"><span class="ds-label">In</span><span class="ds-value ds-mono">50</span></div><div class="ds-ov-node-card__stat"><span class="ds-label">Degree</span><span class="ds-value ds-mono">3</span></div></div><!-- BUG-1: Interact Mode Trustlines section ---------------------------><hr class="ds-ov-node-card__divider"><!-- Quick-action buttons --><div class="nco-interact-actions"><button class="ds-btn ds-btn--primary ds-btn--sm" type="button" data-testid="node-card-send-payment"> 💸 Send Payment </button><button class="ds-btn ds-btn--secondary ds-btn--sm" type="button" data-testid="node-card-new-trustline"> ＋ New Trustline </button></div><!-- Trustlines list: grouped OUT / IN --><div class="nco-trustlines"><!-- OUT group --><div class="nco-tl-group-header">OUT → 1</div><div class="nco-trustline-row" title="avail: 88.00"><span class="nco-trustline-row__peer ds-mono">Alice</span><span class="nco-trustline-row__amounts ds-mono">12.00 / 100.00</span><span class="nco-trustline-row__avail ds-mono">avail: 88.00</span><button class="ds-btn ds-btn--ghost ds-btn--icon nco-trustline-row__edit" type="button" title="Edit trustline" aria-label="Edit trustline">✏️</button></div><!-- IN group --><div class="nco-tl-group-header nco-tl-group-header--gap">IN ← 0</div></div></div></div></div>"`;
