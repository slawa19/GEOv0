# LF in the worktree for every text file, not just the extensions listed below.
# `text=auto` alone leaves the decision to the checkout's core.autocrlf, so on Windows
# an unlisted extension (.snap, .mjs, .toml, .txt) lands as CRLF while the tools that
# rewrite it - vitest snapshots above all - write LF. The file then reads as modified
# after every gate run, and AGENTS.md §6 measures debt on a clean tree. Windows-native
# scripts keep CRLF through their own eol=crlf entries below.
* text=auto eol=lf

# Source code: keep LF to reduce diff noise across OSes.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Windows-native scripts: keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
