# Admin UI environment (example)
#
# The Admin UI calls the backend API directly from the browser; it has no mock mode (removed
# 2026-10-07, 032 S4). Requires the backend running (default local: http://127.0.0.1:18000).
#
VITE_API_BASE_URL=http://127.0.0.1:18000
# The backend's ADMIN_TOKEN. In a dev server without it the UI uses the backend's default dev token;
# a production build without a token refuses every admin request with an authorization error.
# VITE_ADMIN_TOKEN=

# Notes:
# - Vite dev proxy is NOT configured by default in this repo, so prefer VITE_API_BASE_URL.
