# GEO Hub environment template.
# Copy to .env, replace every blank security value, then start the base Compose
# stack. For intentional local defaults and hot reload, use docker-compose.dev.yml.

# Environment: dev | test | staging | prod
# Aliases accepted by the app: development, testing, stage, production.
# ENV is canonical; ENVIRONMENT is compatibility-only.
ENV=prod

# Database
# REQUIRED by the application, PostgreSQL through asyncpg only (postgresql+asyncpg://);
# there is no default and no SQLite (programme 017). Compose never reads this line:
# docker-compose.yml sets DATABASE_URL to the `db` service itself, and scripts/run_local.ps1,
# scripts/run_full_stack.ps1 and the test tier (from TEST_DATABASE_URL) set their own in the
# process environment, which takes precedence over this file. Uncomment it only when you run the app
# yourself against a PostgreSQL you manage - from the host use 127.0.0.1, not localhost
# (the local cluster listens on IPv4 only) and not `db` (a name only Compose resolves).
# DATABASE_URL=postgresql+asyncpg://geo:geo@127.0.0.1:5432/geov0

# Redis
# Same story: docker-compose.yml sets both for the app container. Uncommented,
# REDIS_ENABLED=true makes startup fail closed when Redis is unreachable
# (app/main.py) - inside the test process too, where it shows up as tests that are
# green one at a time and red together.
# REDIS_URL=redis://localhost:6379/0
# REDIS_ENABLED=true

# Security (required and intentionally blank outside dev/test)
# Each secret must be at least 32 characters. Generate independent random values,
# for example with: openssl rand -hex 32
JWT_SECRET=
ADMIN_TOKEN=
SIMULATOR_SESSION_SECRET=
# Comma-separated exact HTTP(S) origins (no path/query/fragment), for example:
# https://simulator.example.com
SIMULATOR_CSRF_ORIGIN_ALLOWLIST=

# JWT policy
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
LOG_LEVEL=INFO
DEBUG=false

# Challenge
AUTH_CHALLENGE_EXPIRE_SECONDS=300

# Payment Engine
PREPARE_LOCK_TTL_SECONDS=30
